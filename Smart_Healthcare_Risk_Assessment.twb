      <aliases enabled='yes' />
      <column caption='Age group' datatype='string' name='[Calculation_1650427506368512]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;&lt;30&quot;&#13;&#10;ELSEIF [age] &lt; 40 THEN &quot;30–39&quot;&#13;&#10;ELSEIF [age] &lt; 50 THEN &quot;40–49&quot;&#13;&#10;ELSEIF [age] &lt; 60 THEN &quot;50–59&quot;&#13;&#10;ELSEIF [age] &lt; 70 THEN &quot;60–69&quot;&#13;&#10;ELSE &quot;70–79&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI category' datatype='string' name='[Calculation_1650427506688001]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#13;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
      <column caption='Disease Count' datatype='integer' name='[Calculation_1650427506835458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[heart_disease] + [diabetes] + [stroke]' />
      </column>
      <column caption='Exercise Category' datatype='string' name='[Calculation_1650427507052548]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [exercise_level] = 0 THEN &quot;Low&quot;&#13;&#10;ELSEIF [exercise_level] = 1 THEN &quot;Moderate&quot;&#13;&#10;ELSEIF [exercise_level] = 2 THEN &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Smoking HD Rate' datatype='integer' name='[Calculation_1650427513262085]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [smoking] = 1 THEN [heart_disease] END' />
      </column>
      <column caption='Alcohol HD Rate' datatype='integer' name='[Calculation_1650427513335814]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [alcohol] = 1 THEN [heart_disease] END' />
      </column>
      <column caption='Low Exercise HD Rate' datatype='integer' name='[Calculation_1650427513421831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [exercise_level] = 0 THEN [heart_disease] END' />
      </column>
      <column caption='Fatigue HD Rate' datatype='integer' name='[Calculation_1650427513475080]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [fatigue] = 1 THEN [heart_disease] END' />
      </column>
      <column caption='Chest Pain HD Rate' datatype='integer' name='[Calculation_1650427513536521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [chest_pain] = 1 THEN [heart_disease] END' />
      </column>
      <column caption='Dizziness HD Rate' datatype='integer' name='[Calculation_1650427513593866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [dizziness] = 1 THEN [heart_disease] END' />
      </column>
